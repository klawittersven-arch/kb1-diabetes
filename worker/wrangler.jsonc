// Cloudflare-Worker für die Fortschrittsanzeige am Beamer.
// Veröffentlicht wird automatisch über den GitHub-Workflow
// .github/workflows/fortschritt-worker.yml (siehe README).
{
  "name": "kb1-diabetes-fortschritt",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "RAUM", "class_name": "Raum" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Raum"] }],
  "vars": {
    // So lange gibt es einen Raum; danach wird alles automatisch gelöscht.
    "LEBENSDAUER_MINUTEN": "360"
  },
  // Keine Protokolle bei Cloudflare speichern (enthielten sonst Vornamen).
  "observability": { "enabled": false }
}
